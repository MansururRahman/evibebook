generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  name         String   @db.VarChar(80)
  passwordHash String
  bio          String?  @db.VarChar(500)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts            Post[]
  reactions        Reaction[]
  comments         Comment[]
  sentRequests     Friendship[] @relation("FriendshipRequester")
  receivedRequests Friendship[] @relation("FriendshipAddressee")

  createdGroups     Group[]            @relation("GroupCreator")
  groupMemberships  GroupMember[]
  groupJoinRequests GroupJoinRequest[]
  pageMemberships   PageMember[]
  pageFollows       PageFollow[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  body      String   @db.VarChar(2000)
  imageUrl  String?
  groupId   String?
  pageId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  page      Page?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([groupId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([pageId, createdAt(sort: Desc), id(sort: Desc)])
}

enum ReactionType {
  LIKE
  LOVE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

/// One reaction per user per post; changing it replaces the row's type.
model Reaction {
  userId    String
  postId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
}

model Group {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String       @db.VarChar(80)
  description String?      @db.VarChar(500)
  privacy     GroupPrivacy @default(PUBLIC)
  creatorId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  creator      User               @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  joinRequests GroupJoinRequest[]
  posts        Post[]
}

/// One row per user per group; the creator starts as ADMIN.
model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

/// Pending request to join a PRIVATE group; accepting moves it to GroupMember.
model GroupJoinRequest {
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

enum PageRole {
  ADMIN
  EDITOR
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   PageMember[]
  followers PageFollow[]
  posts     Post[]
}

/// The page's team. The creator is the first ADMIN; there is no creator column,
/// so deleting a user who handed the page off never deletes the page.
model PageMember {
  pageId   String
  userId   String
  role     PageRole @default(EDITOR)
  joinedAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageId, userId])
  @@index([userId])
}

model PageFollow {
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageId, userId])
  @@index([userId])
}
