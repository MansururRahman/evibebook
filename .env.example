# Postgres from docker-compose.yml (host port 5433 so it does not clash with a local Postgres on 5432)
DATABASE_URL="postgresql://evibebook:evibebook@localhost:5433/evibebook?schema=public"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
# Where uploaded images are stored on disk (relative to the repo root)
UPLOAD_DIR="./uploads"
